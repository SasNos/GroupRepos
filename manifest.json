{
  "manifest_version": 3,
  "name": "Group Repos",
  "version": "0.1.0",
  "description": "Sort the repositories on a GitHub profile into your own lists and fold them away.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
