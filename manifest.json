{
  "manifest_version": 3,
  "name": "Group Repos",
  "version": "1.1.0",
  "description": "Adds a tab bar to the Repositories tab of a GitHub profile, so you can switch between your GitHub lists.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
